# Shared image for the Spring Boot apps: plain JRE with JVM defaults (same as apps/kogito/Dockerfile.jvm).
# Build from the app folder: docker build -f apps/Dockerfile.springboot -t bench-<engine>:1.0.0 apps/<engine>
FROM eclipse-temurin:21.0.9_10-jre
WORKDIR /app
COPY target/app.jar ./
EXPOSE 8080
CMD ["java", "-jar", "app.jar"]
