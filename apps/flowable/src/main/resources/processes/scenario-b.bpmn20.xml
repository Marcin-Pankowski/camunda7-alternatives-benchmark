<?xml version="1.0" encoding="UTF-8"?>
<!-- Scenario B: start via REST, one decision task evaluating the 100-rule pricing table (dmn/pricing.dmn, COLLECT + SUM),
     result returned synchronously. Flowable sets the single result's output "fee" as process variable. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" id="Definitions_ScenarioB" targetNamespace="http://example.com/bench">
  <bpmn:process id="ScenarioB" isExecutable="true">
    <bpmn:startEvent id="Start" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Rules" />
    <bpmn:serviceTask id="Rules" name="Pricing" flowable:type="dmn">
      <bpmn:extensionElements>
        <flowable:field name="decisionTableReferenceKey"><flowable:string>Pricing</flowable:string></flowable:field>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="Rules" targetRef="End" />
    <bpmn:endEvent id="End" />
  </bpmn:process>
  <!-- Diagram layout only (BPMN editors show an empty canvas without it); no effect on execution. -->
  <bpmndi:BPMNDiagram id="Diagram_ScenarioB">
    <bpmndi:BPMNPlane id="Plane_ScenarioB" bpmnElement="ScenarioB">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="100" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rules" bpmnElement="Rules"><dc:Bounds x="190" y="120" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End"><dc:Bounds x="340" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1"><di:waypoint x="136" y="160"/><di:waypoint x="190" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f2" bpmnElement="f2"><di:waypoint x="290" y="160"/><di:waypoint x="340" y="160"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
