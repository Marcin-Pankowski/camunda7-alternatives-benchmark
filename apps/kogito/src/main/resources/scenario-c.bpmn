<?xml version="1.0" encoding="UTF-8"?>
<!-- Scenario C: start via REST, one business rule task evaluating the 100-rule pricing table (pricing.dmn, COLLECT + SUM),
     result returned synchronously. Kogito maps the process variables to the DMN inputs by name; the output is the decision "fee". -->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ScenarioC" targetNamespace="http://example.com/bench">
  <bpmn2:itemDefinition id="_intItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_stringItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_feeItem" structureRef="Integer"/>
  <bpmn2:process id="ScenarioC" drools:packageName="de.piu.bpmn.benchmark" drools:version="1.0" isExecutable="true" processType="Public">
    <bpmn2:property id="age" itemSubjectRef="_intItem" name="age"/>
    <bpmn2:property id="amount" itemSubjectRef="_intItem" name="amount"/>
    <bpmn2:property id="country" itemSubjectRef="_stringItem" name="country"/>
    <bpmn2:property id="customerType" itemSubjectRef="_stringItem" name="customerType"/>
    <bpmn2:property id="fee" itemSubjectRef="_feeItem" name="fee"/>
    <bpmn2:startEvent id="Start"><bpmn2:outgoing>f1</bpmn2:outgoing></bpmn2:startEvent>
    <bpmn2:sequenceFlow id="f1" sourceRef="Start" targetRef="Rules"/>
    <bpmn2:businessRuleTask id="Rules" name="Pricing" implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:incoming>f1</bpmn2:incoming><bpmn2:outgoing>f2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="Rules_namespaceInput" drools:dtype="java.lang.String" name="namespace"/>
        <bpmn2:dataInput id="Rules_modelInput" drools:dtype="java.lang.String" name="model"/>
        <bpmn2:dataInput id="Rules_decisionInput" drools:dtype="java.lang.String" name="decision"/>
        <bpmn2:dataInput id="Rules_ageInput" drools:dtype="Integer" name="age"/>
        <bpmn2:dataInput id="Rules_amountInput" drools:dtype="Integer" name="amount"/>
        <bpmn2:dataInput id="Rules_countryInput" drools:dtype="String" name="country"/>
        <bpmn2:dataInput id="Rules_customerTypeInput" drools:dtype="String" name="customerType"/>
        <bpmn2:dataOutput id="Rules_feeOutput" drools:dtype="Integer" name="fee"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>Rules_namespaceInput</bpmn2:dataInputRefs><bpmn2:dataInputRefs>Rules_modelInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Rules_decisionInput</bpmn2:dataInputRefs><bpmn2:dataInputRefs>Rules_ageInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Rules_amountInput</bpmn2:dataInputRefs><bpmn2:dataInputRefs>Rules_countryInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Rules_customerTypeInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet><bpmn2:dataOutputRefs>Rules_feeOutput</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation><bpmn2:targetRef>Rules_namespaceInput</bpmn2:targetRef><bpmn2:assignment><bpmn2:from xsi:type="bpmn2:tFormalExpression">http://example.com/bench/pricing</bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression">Rules_namespaceInput</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:targetRef>Rules_modelInput</bpmn2:targetRef><bpmn2:assignment><bpmn2:from xsi:type="bpmn2:tFormalExpression">pricing</bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression">Rules_modelInput</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:targetRef>Rules_decisionInput</bpmn2:targetRef><bpmn2:assignment><bpmn2:from xsi:type="bpmn2:tFormalExpression">fee</bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression">Rules_decisionInput</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>age</bpmn2:sourceRef><bpmn2:targetRef>Rules_ageInput</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>amount</bpmn2:sourceRef><bpmn2:targetRef>Rules_amountInput</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>country</bpmn2:sourceRef><bpmn2:targetRef>Rules_countryInput</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>customerType</bpmn2:sourceRef><bpmn2:targetRef>Rules_customerTypeInput</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Rules_feeOutput</bpmn2:sourceRef><bpmn2:targetRef>fee</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:businessRuleTask>
    <bpmn2:sequenceFlow id="f2" sourceRef="Rules" targetRef="End"/>
    <bpmn2:endEvent id="End"><bpmn2:incoming>f2</bpmn2:incoming></bpmn2:endEvent>
  </bpmn2:process>
  <!-- Diagram layout only (BPMN editors show an empty canvas without it); no effect on execution. -->
  <bpmndi:BPMNDiagram id="Diagram_ScenarioC">
    <bpmndi:BPMNPlane id="Plane_ScenarioC" bpmnElement="ScenarioC">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="100" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rules" bpmnElement="Rules"><dc:Bounds x="190" y="120" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End"><dc:Bounds x="340" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1"><di:waypoint x="136" y="160"/><di:waypoint x="190" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f2" bpmnElement="f2"><di:waypoint x="290" y="160"/><di:waypoint x="340" y="160"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
